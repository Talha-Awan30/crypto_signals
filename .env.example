# ========== Email (Gmail SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# ========== Run mode ==========
# loop = run forever (Oracle/VPS).  once = single cycle (for testing).
RUN_MODE=loop
LOOP_INTERVAL_SEC=60

# ========== Exchange fallback chain ==========
# Tried left-to-right at startup. First one that works on your IP is used.
# binanceusdm tends to fail on cloud IPs; OKX/KuCoin usually succeed.
EXCHANGE_PREFERENCE=binanceusdm,okx,kucoinfutures,bitget

# ========== State path ==========
STATE_PATH=state/v5_state.json
