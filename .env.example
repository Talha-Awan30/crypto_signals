# ========== Notifier selection ==========
# Options: email | telegram
NOTIFIER=email

# ========== Email (Gmail SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# ========== Telegram (alternative) ==========
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========== Scanner config ==========
# Comma-separated. Core symbols are always included.
CORE_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,ADA/USDT:USDT,ONDO/USDT:USDT
# How many additional top-volume perps to also scan
BROADER_TOP_N=20
# Exchange (ccxt id). binanceusdm = Binance USDT-M perps
EXCHANGE_ID=binanceusdm

# Run mode: once (GitHub Actions) | loop (Oracle/VPS)
RUN_MODE=once
# Interval in minutes when RUN_MODE=loop
LOOP_INTERVAL_MIN=5

# CryptoPanic (public free feed — no key required, but you can add one)
CRYPTOPANIC_TOKEN=
